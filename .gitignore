# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Generated documentation artifacts
/docs/_build/
/docs/generated/

# Test, coverage, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/

# Jupyter and tooling state
.ipynb_checkpoints/
.vscode/

# SKSurrogate optimization checkpoints and serialized results
example*-checkpoints/
*.eoa
*.pkl
*.db
*.sqlite
*.sqlite3
*.joblib

# OS metadata
.DS_Store
Thumbs.db

# SKSurrogate API runtime state (bundles, jobs, datasets, predictions, registry, mltrace DBs)
/var/

# Benchmark raw results (aggregates in docs/benchmarks are committed; raw data goes to Zenodo)
benchmarks/results/

# Generated documentation builds and scratch outputs
/SKSurrogate-documentation.pdf
/docs/*.pdf
*.tsbuildinfo
/docs/*.eoa
/docs/*.pkl
playwright-report/

# ---------------------------------------------------------------------------
# Working notes.
#
# Contributor-facing plans, handoffs and decision records live in dev-notes/
# and ARE tracked — see dev-notes/README.md for the rule and the inventory.
# Only unpublished drafts are ignored, under dev-notes/private/. Repository-wide
# enforcement: tests/test_repo_layout.py fails if a *PLAN*.md / HANDOFF-*.md /
# AI_LAYER*.md reappears at the root.
#
# The per-file entries below are legacy notes that stay local-only because they
# quote internal deliberation. Promote one by moving it into dev-notes/ and
# deleting its line here.
# ---------------------------------------------------------------------------
/dev-notes/private/
/AI_LAYER_ROADMAP.md
/AI_LAYER02_B1_ARTIFACT_INGESTION_SCOPE.md
/AI_LAYER02_B2_ARTIFACT_RECOVERY.md
/AI_LAYER02_C1_SHAP_DECISION.md
/AI_LAYER02_EDA_PLAN.md
/AI_LAYER02_FOLLOWUP_PLAN.md
/API_SIMPLIFICATION_PLAN.md
/AUTH_AND_SHARING_PLAN.md
/HANDOFF-logging-telemetry.md
/HANDOFF-website-seo.done.md
/HANDOFF-website-seo.md
/HANDOFF.md
/LAUNCH_PLAN.md
/LOGGING_TELEMETRY_PLAN.md
/MCP_SERVER_SCOPE.md
/TIME_SERIES_PLAN.md
/ai_layer02.md
/ailayer.md
/IDEA.md
/logging.md
err.log
LaTeXDocker.md
.hermes/preview-chip-contrast.html

# GitHub: local workflow scratch/overrides. Files already in the index stay
# tracked (.gitignore never affects them), so this only shields future untracked
# files under .github/. Public artefacts — the workflows, scripts/ and
# ISSUE_TEMPLATE/ — are added deliberately with `git add -f`.
.github/

# Example notebooks write their report artifacts here (regenerate by running them).
/examples/notebooks/*-report/
/classification-report/
/regression-report/
/forecasting-report/
