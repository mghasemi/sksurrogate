# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Generated documentation artifacts
/docs/_build/
/docs/generated/

# Test, coverage, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/

# Jupyter and tooling state
.ipynb_checkpoints/
.vscode/

# SKSurrogate optimization checkpoints and serialized results
example*-checkpoints/
*.eoa
*.pkl
*.db
*.sqlite
*.sqlite3
*.joblib

# OS metadata
.DS_Store
Thumbs.db

# SKSurrogate API runtime state (bundles, jobs, datasets, predictions, registry, mltrace DBs)
/var/

# Benchmark raw results (aggregates in docs/benchmarks are committed; raw data goes to Zenodo)
benchmarks/results/

# Generated documentation builds and scratch outputs
/SKSurrogate-documentation.pdf
/docs/*.pdf
*.tsbuildinfo
/docs/*.eoa
/docs/*.pkl
playwright-report/

# Internal working documents and plans — maintainer planning notes, not user
# documentation. Kept local and out of the public repo (see P2.2).
#
# .gitignore is inert for files git already tracks: a name listed here that is
# still in the index stays in the public repo until it leaves with
# `git rm --cached`. Six are still tracked, because shipped code and published
# docs cite them as design contracts and each carries an "Internal working
# document." banner:
#
#   AI_LAYER02_D2_LLM_SYNTHESIS_SCOPE.md   api/synthesis.py, api/synthesis_facts.py
#   AI_LAYER02_D3_ROW_LEVEL_CONTRACT.md    docs/mltrace.rst
#   AI_LAYER02_D4_READINESS_ASSESSMENT.md  docs/experiment-design.rst,
#                                          benchmarks/design_readiness.py
#   AI_LAYER02_REMAINING_PLAN.md           benchmarks/datasets.py, dgps.py,
#                                          methods.py, benchmarks/DESIGN.md
#   HANDOFF-explainability-visibility.md   docs/images/make_stability_contour.py
#   UI_DOCKER_UPGRADE_PLAN.md              docs/ui-plan.md
#
# Everything else listed here is untracked, so these rules apply directly.
/AI_LAYER_ROADMAP.md
/AI_LAYER02_B1_ARTIFACT_INGESTION_SCOPE.md
/AI_LAYER02_B2_ARTIFACT_RECOVERY.md
/AI_LAYER02_C1_SHAP_DECISION.md
