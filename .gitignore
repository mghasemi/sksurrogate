# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Generated documentation artifacts
/docs/_build/
/docs/generated/

# Test, coverage, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/

# Jupyter and tooling state
.ipynb_checkpoints/
.vscode/

# SKSurrogate optimization checkpoints and serialized results
example*-checkpoints/
*.eoa
*.pkl
*.db
*.sqlite
*.sqlite3
*.joblib

# OS metadata
.DS_Store
Thumbs.db

# SKSurrogate API runtime state (bundles, jobs, datasets, predictions, registry, mltrace DBs)
/var/

# Benchmark raw results (aggregates in docs/benchmarks are committed; raw data goes to Zenodo)
benchmarks/results/

# Generated documentation builds and scratch outputs
/SKSurrogate-documentation.pdf
/docs/*.pdf
*.tsbuildinfo
/docs/*.eoa
/docs/*.pkl
playwright-report/

# Internal working documents and plans — maintainer planning notes, not user
# documentation. Kept local and out of the public repo (see P2.2).
#
# .gitignore is inert for files git already tracks: a name listed here that is
# still in the index stays in the public repo until it leaves with
# `git rm --cached`. Of the names below, the AI_LAYER02_*, AI_LAYER_ROADMAP,
# API_SIMPLIFICATION_PLAN, HANDOFF-explainability-visibility, LAUNCH_PLAN and
# UI_DOCKER_UPGRADE_PLAN documents are still tracked, because shipped code and
# published docs cite them as design contracts; they each carry an
# "Internal working document." banner. The rest are already untracked.
/AI_LAYER_ROADMAP.md
/AI_LAYER02_B1_ARTIFACT_INGESTION_SCOPE.md
/AI_LAYER02_B2_ARTIFACT_RECOVERY.md
/AI_LAYER02_C1_SHAP_DECISION.md
/AI_LAYER02_D2_LLM_SYNTHESIS_SCOPE.md
/AI_LAYER02_D3_ROW_LEVEL_CONTRACT.md
/AI_LAYER02_D4_READINESS_ASSESSMENT.md
/AI_LAYER02_EDA_PLAN.md
/AI_LAYER02_FOLLOWUP_PLAN.md
/AI_LAYER02_REMAINING_PLAN.md
/API_SIMPLIFICATION_PLAN.md
/AUTH_AND_SHARING_PLAN.md
